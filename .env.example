# Скопируйте этот файл в .env и заполните значения.
# Файл .env в git не попадает (см. .gitignore), а этот — только плейсхолдеры.

# --- ВКонтакте ---------------------------------------------------------------
# Токен сообщества: Управление сообществом -> Работа с API -> Ключи доступа
VK_TOKEN=вставьте_токен_сообщества

# --- ProxyAPI (https://proxyapi.ru) ------------------------------------------
# Ключ API из личного кабинета ProxyAPI
PROXYAPI_API_KEY=вставьте_ключ_proxyapi

# Базовый адрес OpenAI-совместимого API (менять не обязательно)
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1

# Модель gpt-4.1-mini. У ProxyAPI идентификатор состоит из вендора и названия
# через слэш (см. https://proxyapi.ru/docs), поэтому записывается так:
AI_MODEL=openai/gpt-4.1-mini
# Если API ответит "model not found" — попробуйте записать модель без префикса:
# AI_MODEL=gpt-4.1-mini

# Системный промпт AI-помощника
AI_SYSTEM_PROMPT=Ты — дружелюбный AI-помощник внутри ВКонтакте. Отвечай кратко и по делу, на языке собеседника.

# Сколько последних реплик истории держать в памяти на диалог (0 — без истории)
AI_HISTORY_LIMIT=10

# --- LongPoll ----------------------------------------------------------------
# Секунды ожидания ответа LongPoll (ВК принудительно ответит по таймауту)
LONGPOLL_WAIT=25
# Задержка между запросами, сек (0 — без задержки)
LONGPOLL_RPS_DELAY=0

# --- Логирование -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
